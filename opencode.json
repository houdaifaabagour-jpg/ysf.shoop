{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "@21st-dev/magic": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@21st-dev/magic@latest"
      ],
      "environment": {
        "API_KEY": "56f3a8cdf57f898a0802bb8bd84f4d36d48857a1693e1dbfe41470526b87f42f"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PAT}"
      },
      "enabled": true
    }
  }
}
